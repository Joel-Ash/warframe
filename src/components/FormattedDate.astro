---
interface Props {
  updatedDate?: Date;
}

const { updatedDate } = Astro.props;

const ymd = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
---

{
  updatedDate && (
    <span class="dates">
      <time datetime={updatedDate.toISOString()}>
        업데이트 날짜: {ymd(updatedDate)}
      </time>
    </span>
  )
}

<style>
  .dates {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
  }
</style>